# Copy to .env on the server notebook and fill in. .env is gitignored — never commit it.

# Postgres credentials. The volume is initialised with these on FIRST start only;
# changing them later requires recreating the db-data volume.
POSTGRES_DB=cookoff
POSTGRES_USER=cookoff
POSTGRES_PASSWORD=change-me

# The URL guests will open — the server notebook's LAN IP or hostname. This is what gets
# embedded in access links and QR codes, so localhost will NOT work here.
APP_FRONTEND_BASE_URL=http://192.168.1.50

# Published port on the server notebook.
HTTP_PORT=80

# Which published images to run. Pin to a commit SHA for a reproducible rollback.
IMAGE_PREFIX=ghcr.io/hahah11/cookingchallenge
IMAGE_TAG=latest

# --- Email ---------------------------------------------------------------------
# Leave APP_MAIL_ENABLED=false to keep the current behaviour: invitation links are only
# written to the backend log, and nothing is sent. Set it to true to mail them, which needs
# an SMTP relay reachable from the server notebook.
#
# Gmail example: host smtp.gmail.com, port 587, username your address, password an
# app password (not the account password), auth + STARTTLS both true.
APP_MAIL_ENABLED=false
APP_MAIL_FROM=CookOff <no-reply@cookoff.local>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
