{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badge/**",
              "components/button/**",
              "components/card/**",
              "components/checkbox/**",
              "components/chip/**",
              "components/dialog/**",
              "components/divider/**",
              "components/fab/**",
              "components/icon-button/**",
              "components/navigation-bar/**",
              "components/progress-indicator/**",
              "components/radio-button/**",
              "components/snackbar/**",
              "components/switch/**",
              "components/tabs/**",
              "components/text-field/**",
              "components/top-app-bar/**",
              "ui_kits/cookoff/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Roboto Mono|Material Symbols Outlined))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Roboto Mono, Material Symbols Outlined."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: count, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|icon|disabled|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, label, icon, disabled, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|outlined|text|elevated|tonal)$/]",
        "message": "<Button> variant must be one of 'filled' | 'outlined' | 'text' | 'elevated' | 'tonal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|media|title|subtitle|body|actions|clickable|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, media, title, subtitle, body, actions, clickable, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:elevated|filled|outlined)$/]",
        "message": "<Card> variant must be one of 'elevated' | 'filled' | 'outlined'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|icon|selected|onClick|onRemove|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: variant, label, icon, selected, onClick, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:assist|filter|input|suggestion|elevated)$/]",
        "message": "<Chip> variant must be one of 'assist' | 'filter' | 'input' | 'suggestion' | 'elevated'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|actions|onScrimClick|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: icon, title, body, actions, onScrimClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:inset|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fab'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|icon|label|onClick|key|ref|className|style|children)$/]",
        "message": "<Fab> doesn't accept that prop. Declared props: size, variant, icon, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fab'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|regular|large)$/]",
        "message": "<Fab> size must be one of 'small' | 'regular' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fab'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|surface)$/]",
        "message": "<Fab> variant must be one of 'primary' | 'surface'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|selected|disabled|onClick|label|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, icon, selected, disabled, onClick, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|filled|tonal|outlined)$/]",
        "message": "<IconButton> variant must be one of 'standard' | 'filled' | 'tonal' | 'outlined'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|value|key|ref|className|style|children)$/]",
        "message": "<ProgressIndicator> doesn't accept that prop. Declared props: variant, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressIndicator'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:linear|circular)$/]",
        "message": "<ProgressIndicator> variant must be one of 'linear' | 'circular'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|name|disabled|key|ref|className|style|children)$/]",
        "message": "<RadioButton> doesn't accept that prop. Declared props: label, checked, onChange, name, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Snackbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<Snackbar> doesn't accept that prop. Declared props: message, actionLabel, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|activeIndex|onChange|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, activeIndex, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|value|onChange|placeholder|type|error|supportingText|disabled|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: variant, label, value, onChange, placeholder, type, error, supportingText, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outlined|filled)$/]",
        "message": "<TextField> variant must be one of 'outlined' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopAppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|leadingIcon|onLeadingClick|actions|center|key|ref|className|style|children)$/]",
        "message": "<TopAppBar> doesn't accept that prop. Declared props: title, leadingIcon, onLeadingClick, actions, center."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
